# Postgres (Railway ya la vincula automáticamente a este servicio)
DATABASE_URL=

# Secreto para verificar peticiones del webhook de Wix (campo "secret" en el body)
WIX_WEBHOOK_SECRET=

# URL pública de la página de Pricing Plans en Wix, a donde se redirige
# a los usuarios sin suscripción activa
WIX_PRICING_URL=

# Secreto compartido con el backend de tokens (growthcheck-main), para
# sincronizar el estado de la suscripción con POST /cliente/suscripcion
WEBHOOK_SECRET_BACKEND=

# URL base del backend de tokens. Opcional: si se omite, usa
# https://web-production-333dd.up.railway.app
TOKENS_BACKEND_URL=

# Secreto usado para firmar la cookie de sesión (HMAC)
APP_SECRET=

# Resend (envío del magic link)
RESEND_API_KEY=
RESEND_FROM=contacto@growthcheck.ink
