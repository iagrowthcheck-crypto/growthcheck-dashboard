# Postgres (Railway ya la vincula automáticamente a este servicio)
DATABASE_URL=

# Secreto para verificar peticiones del webhook de Wix (header X-Webhook-Secret)
WIX_WEBHOOK_SECRET=

# URL pública de la página de Pricing Plans en Wix, a donde se redirige
# a los usuarios sin suscripción activa
WIX_PRICING_URL=

# Secreto usado para firmar la cookie de sesión (HMAC)
APP_SECRET=

# Resend (envío del magic link)
RESEND_API_KEY=
RESEND_FROM=contacto@growthcheck.ink
